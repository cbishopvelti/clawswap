{
  "Name": "clawswap",
  "Description": "Switches a dev checkout's branch and restarts its servers, through the clawswap daemon.",
  "Author": "clawswap",
  "Version": "2.1.0",
  "SDKVersion": 2,
  "CodePath": "bin/plugin",
  "Icon": "icons/branch",
  "Category": "clawswap",
  "CategoryIcon": "icons/branch",
  "OS": [
    {
      "Platform": "linux"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "10.15"
    }
  ],
  "Software": {
    "MinimumVersion": "6.4"
  },
  "Actions": [
    {
      "UUID": "dev.clawswap.branch",
      "Name": "clawswap branch",
      "Tooltip": "Switches the dev checkout to a branch and restarts its servers (needs clawswap up)",
      "Icon": "icons/branch",
      "States": [
        {
          "Image": "icons/branch"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "pi/branch.html"
    },
    {
      "UUID": "dev.clawswap.pull",
      "Name": "clawswap pull",
      "Tooltip": "Pulls the branch the dev checkout is on and restarts its servers if anything came in (needs clawswap up)",
      "Icon": "icons/pull",
      "States": [
        {
          "Image": "icons/pull"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "pi/pull.html"
    },
    {
      "UUID": "dev.clawswap.walk",
      "Name": "clawswap walkthrough",
      "Tooltip": "Plays the checkout's walkthrough in Chrome (needs clawswap up)",
      "Icon": "icons/walk",
      "States": [
        {
          "Image": "icons/walk"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "pi/walk.html"
    },
    {
      "UUID": "dev.clawswap.project",
      "Name": "clawswap project",
      "Tooltip": "Shows the project the other keys follow, and selects the next one (needs clawswap up in two projects)",
      "Icon": "icons/project",
      "States": [
        {
          "Image": "icons/project"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "pi/project.html"
    }
  ],
  "CodePathLin": "bin/plugin",
  "CodePathMac": "bin/plugin"
}
