# clawswap completion for bash: source this from ~/.bashrc, or save it as
# ~/.local/share/bash-completion/completions/clawswap
_clawswap() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  if [ "$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=($(compgen -W "up reload" -- "$cur"))
    return
  fi
  case "${COMP_WORDS[1]}" in
    switch) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "$(git for-each-ref --format='%(refname:lstrip=3)' refs/remotes/origin 2>/dev/null | grep -v '^HEAD$')" -- "$cur")) ;;
    up|watch) COMPREPLY=($(compgen -W "$(find . -maxdepth 1 -name 'clawswap.*' 2>/dev/null | sed -nE 's#^\./clawswap\.(.+)\.(exs|yml|yaml)$#\1#p')" -- "$cur")) ;;
    
    completion) COMPREPLY=($(compgen -W "install bash zsh fish" -- "$cur")) ;;
    help) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "up reload" -- "$cur")) ;;
  esac
}
complete -F _clawswap clawswap
