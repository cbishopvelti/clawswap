#compdef clawswap
# clawswap completion for zsh: save it as _clawswap in a folder on your $fpath, or source it from
# ~/.zshrc after compinit
_clawswap() {
  local -a commands
  commands=(
    'up:Start'
    'reload:Reload'
  )
  if (( CURRENT == 2 )); then
    _describe command commands
    return
  fi
  case $words[2] in
    switch) (( CURRENT == 3 )) && compadd -- ${(f)"$(git for-each-ref --format='%(refname:lstrip=3)' refs/remotes/origin 2>/dev/null | grep -v '^HEAD$')"} ;;
    up|watch) compadd -- ${(f)"$(find . -maxdepth 1 -name 'clawswap.*' 2>/dev/null | sed -nE 's#^\./clawswap\.(.+)\.(exs|yml|yaml)$#\1#p')"} ;;
    daemon) (( CURRENT == 3 )) && compadd -- stop; (( CURRENT == 4 )) && compadd -- --all ;;
    
    completion) compadd -- install bash zsh fish ;;
  esac
}
if [ "$funcstack[1]" = "_clawswap" ]; then _clawswap "$@"; else compdef _clawswap clawswap; fi
